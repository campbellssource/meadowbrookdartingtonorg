---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { zoneFor } from '../lib/zones';

interface Props {
  title: string;
  description?: string;
  navOnPhoto?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = "Meadowbrook is managed by The Dartington Recreation Association, a charity run by volunteers.",
  navOnPhoto = false,
  bodyClass = "",
} = Astro.props;

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const reader = createReader(process.cwd(), keystaticConfig);
const navFacilities = (await reader.collections.facilities.all())
  .sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Meadowbrook Dartington</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body class={`mw-app ${bodyClass}`}>
    <header class={`mw-nav ${navOnPhoto ? "on-photo" : ""}`}>
      <div class="mw-wrap mw-nav-inner">
        <a href="/" class="mw-nav-brand" aria-label="Meadowbrook home">
          <img src="/assets/logos/hand.png" alt="Meadowbrook + DRA logo" />
          <span>
            <span class="mark">Meadowbrook</span>
            <small>The Dartington Recreation Association</small>
          </span>
        </a>
        <nav>
          <ul class="mw-nav-links">
            <li><a href="/" class={`mw-nav-link ${isActive("/") ? "active" : ""}`}>Home</a></li>
            <li class="has-mega">
              <a href="/facilities" class={`mw-nav-link ${isActive("/facilities") ? "active" : ""}`}>Facilities</a>
              <div class="mw-mega" role="menu" aria-label="Facilities">
                <div class="mw-wrap mw-mega-inner">
                  {navFacilities.map(({ slug, entry }) => {
                    const isLink = entry.facilityType.discriminant === 'link';
                    const isBookable = entry.facilityType.discriminant === 'bookable';
                    const href = isLink ? (entry.facilityType.value as any).externalUrl : `/facilities/${slug}`;
                    const label = isBookable ? 'Book now' : isLink ? 'Open website' : '';
                    return (
                      <a
                        href={href}
                        class={`mw-mega-tile ${zoneFor(slug)}`}
                        role="menuitem"
                        {...(isLink ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      >
                        <span class="eyebrow">{label}</span>
                        <span class="name">{entry.name}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            </li>
            <li><a href="/about" class={`mw-nav-link ${isActive("/about") ? "active" : ""}`}>About</a></li>
            <li><a href="/contact" class={`mw-nav-link hide-mobile ${isActive("/contact") ? "active" : ""}`}>Contact</a></li>
            <li><a href="https://square.link/u/hCp8AnkF" class="mw-btn mw-btn-primary mw-btn-sm">Donate</a></li>
          </ul>
          <button class="mw-nav-menu-btn" aria-expanded="false" aria-controls="mw-mobile-menu">Menu</button>
        </nav>

        <div class="mw-mobile-menu" id="mw-mobile-menu" aria-hidden="true">
          <ul>
            <li><a href="/" class={isActive("/") ? "active" : ""}>Home</a></li>
            <li><a href="/facilities" class={isActive("/facilities") ? "active" : ""}>Facilities</a></li>
            <li><a href="/about" class={isActive("/about") ? "active" : ""}>About</a></li>
            <li><a href="/contact" class={isActive("/contact") ? "active" : ""}>Contact</a></li>
            <li><a href="https://square.link/u/hCp8AnkF" class="mw-btn mw-btn-primary mw-btn-sm">Donate</a></li>
          </ul>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script>
      const btn = document.querySelector('.mw-nav-menu-btn') as HTMLButtonElement;
      const menu = document.getElementById('mw-mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          const open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          menu.setAttribute('aria-hidden', String(open));
          menu.classList.toggle('open', !open);
          btn.textContent = open ? 'Menu' : 'Close';
        });
        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            btn.setAttribute('aria-expanded', 'false');
            menu.setAttribute('aria-hidden', 'true');
            menu.classList.remove('open');
            btn.textContent = 'Menu';
          });
        });
      }
    </script>

    <footer class="mw-footer">
      <div class="mw-wrap">
        <div class="footer-grid">
          <div>
            <h4>Meadowbrook</h4>
            <p>The recreational heart of Dartington — pool, playground, fields, bike track, bar, and a wooden community building.</p>
            <p>Meadowbrook, Shinners Bridge, Dartington, TQ9 6JD</p>
            <p><a href="https://maps.app.goo.gl/ngFR4nEtYtdYe3SG9">Find us on Google Maps</a></p>
          </div>
          <div>
            <h4>Explore</h4>
            <a href="/">Home</a>
            <a href="/facilities">Facilities</a>
            <a href="/about">About the DRA</a>
            <a href="/contact">Contact</a>
          </div>
          <div>
            <h4>Get in touch</h4>
            <a href="mailto:contact@meadowbrookdartington.org">contact@meadowbrookdartington.org</a>
            <a href="https://square.link/u/hCp8AnkF">Donate</a>
            <a href="/privacy">Privacy policy</a>
          </div>
        </div>
        <div class="footer-bottom">
          The Dartington Recreation Association is a registered charity (1168817) run by volunteers.
        </div>
      </div>
    </footer>
  </body>
</html>
