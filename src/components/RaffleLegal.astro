---
// Legally-required lottery ticket information for a UK small society lottery.
// Every ticket/receipt must show: society name, ticket price, organiser name +
// address, and the date of the draw. Rendered on /raffle, /raffle/thanks and
// /entries. Colour-agnostic (uses currentColor) so it sits on the festival
// orange or on paper. See spec/raffle/06-transparency-and-compliance.md.
import {
  SOCIETY_NAME,
  ORGANISER_NAME,
  ORGANISER_ADDRESS,
  DRAW_DATE_LABEL,
  TICKET_PRICE_LABEL,
} from '../lib/raffle';
---

<aside class="raffle-legal" aria-label="Lottery information">
  <p class="rl-title">Lottery information</p>
  <dl class="rl-grid">
    <div><dt>Promoting society</dt><dd>{SOCIETY_NAME}</dd></div>
    <div><dt>Organiser</dt><dd>{ORGANISER_NAME}, {ORGANISER_ADDRESS}</dd></div>
    <div><dt>Ticket price</dt><dd>{TICKET_PRICE_LABEL} per ticket</dd></div>
    <div><dt>Date of draw</dt><dd>{DRAW_DATE_LABEL}</dd></div>
  </dl>
  <p class="rl-note">
    Promoted as a small society lottery under the Gambling Act 2005. All proceeds go to the
    Dartington Recreation Association.
  </p>
</aside>

<style>
  .raffle-legal {
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: var(--r-md, 10px);
    padding: var(--space-5, 1.25rem);
    font-size: 0.85rem;
    line-height: 1.5;
    color: inherit;
  }
  .rl-title {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
    margin: 0 0 var(--space-4, 1rem);
    opacity: 0.85;
  }
  .rl-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4, 1rem) var(--space-6, 2rem);
    margin: 0;
  }
  .rl-grid dt {
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin-bottom: 2px;
  }
  .rl-grid dd { margin: 0; font-weight: 500; }
  .rl-note {
    margin: var(--space-5, 1.25rem) 0 0;
    opacity: 0.8;
  }
  @media (max-width: 560px) {
    .rl-grid { grid-template-columns: 1fr; }
  }
</style>
