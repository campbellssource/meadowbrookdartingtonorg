---
// Reusable social media links. Pass a `variant` to adjust styling context.
// To enable Bluesky once the account exists, fill in `bluesky` below.
interface Props {
  variant?: 'footer' | 'inline';
  class?: string;
}
const { variant = 'inline', class: className = '' } = Astro.props;

const facebook = 'https://www.facebook.com/meadowbrookdartington';
const instagram = 'https://www.instagram.com/meadowbrookdartington/';
const bluesky = ''; // e.g. 'https://bsky.app/profile/meadowbrookdartington.bsky.social'
---

<div class:list={['mw-socials', `mw-socials-${variant}`, className]}>
  <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Meadowbrook on Facebook" title="Facebook">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
      <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/>
    </svg>
  </a>
  <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Meadowbrook on Instagram" title="Instagram">
