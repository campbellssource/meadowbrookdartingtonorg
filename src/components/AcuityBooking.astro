---
interface Props {
  owner?: string;
  category: string;
  height?: string;
}

const {
  owner = "31267337",
  category,
  height = "800px"
} = Astro.props;

const encodedCategory = encodeURIComponent(`category:${category}`);
const iframeSrc = `https://app.acuityscheduling.com/schedule.php?owner=${owner}&appointmentType=${encodedCategory}`;
---

<div class="acuity-booking">
  <iframe
    src={iframeSrc}
    title="Book a session"
    width="100%"
    height={height}
    frameborder="0"
    loading="lazy"
    allow="payment"
  ></iframe>
</div>
<script src="https://embed.acuityscheduling.com/js/embed.js" type="text/javascript"></script>

<style>
  .acuity-booking {
    width: 100%;
    max-width: 100%;
    margin: 2rem 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .acuity-booking iframe {
    display: block;
    border: none;
  }

  @media (max-width: 768px) {
    .acuity-booking iframe {
      min-height: 600px;
    }
  }
</style>
