---
// The mailing-list sign-up form, shared by /subscribe-to-updates and /volunteer.
//
// One form, two jobs. The volunteer variant posts `volunteer: true`, which the
// API turns into a VOLUNTEER attribute on the Brevo contact -- everyone lands on
// the same list, and the attribute is what tells the volunteer sign-ups apart.
//
// Everything is wired through data attributes rather than ids, so a page can hold
// more than one of these without the two forms fighting over the same element.
interface Props {
  /** Mark the contact as a volunteer sign-up in Brevo. */
  volunteer?: boolean;
  /** Volunteers get chased by a human, so their surname is worth asking for. */
  askLastName?: boolean;
  /** Consent wording. The privacy-policy link is appended to whatever is passed. */
  consentText?: string;
  submitLabel?: string;
  successHeading?: string;
  successText?: string;
  /** Shown instead when the address is new and Brevo has sent a confirmation email. */
  confirmHeading?: string;
  confirmText?: string;
  class?: string;
}

const {
  volunteer = false,
  askLastName = false,
  consentText =
    'I agree to receive occasional updates from Meadowbrook and the DRA. '
    + 'You can unsubscribe at any time.',
  submitLabel = 'Subscribe',
  successHeading = "You're subscribed!",
  successText = "Thanks for signing up. We'll be in touch when there's something worth sharing.",
  confirmHeading = 'Check your inbox',
  confirmText =
    "We've sent you an email with a link to confirm your address. Click it and you're done "
    + '— until then you are not on the list. If it has not arrived in a minute or two, have a '
    + 'look in your spam folder.',
  class: className = '',
} = Astro.props;
---

<div
  class:list={['ml-form', className]}
  data-mailing-list-form
  data-volunteer={volunteer ? 'true' : 'false'}
>
  <form novalidate data-ml-form>
    <div class="field-row">
      <label class="field">
        <span class="field-label">First name <span class="optional">(optional)</span></span>
        <input type="text" name="firstName" autocomplete="given-name" placeholder="Your first name" />
      </label>
    </div>

    {askLastName && (
      <div class="field-row">
        <label class="field">
          <span class="field-label">Last name <span class="optional">(optional)</span></span>
          <input type="text" name="lastName" autocomplete="family-name" placeholder="Your last name" />
        </label>
      </div>
    )}

    <div class="field-row">
      <label class="field">
        <span class="field-label">Email address <span class="required">*</span></span>
        <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
      </label>
    </div>

    <div class="field-row">
      <label class="checkbox-label">
        <input type="checkbox" name="consent" required />
        <span>
          {consentText} Read our
          <a href="/privacy" target="_blank" rel="noopener">privacy policy</a>.
        </span>
      </label>
    </div>

    {/* Honeypot. Hidden from people, irresistible to the bots that fill in every
        field they can find. Positioned off-screen rather than display:none, and
        taken out of the tab order and the accessibility tree so nobody using a
        keyboard or a screen reader can land on it by accident. */}
    <div class="honeypot" aria-hidden="true">
      <label>
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="form-message form-message--error" data-ml-error hidden></div>

    <button type="submit" class="mw-btn mw-btn-primary" data-ml-submit>{submitLabel}</button>
  </form>

  <div class="success-wrap" data-ml-success hidden>
    <div class="success-icon">✓</div>
    <h2>{successHeading}</h2>
    <p>{successText}</p>
  </div>

  <div class="success-wrap" data-ml-confirm hidden>
    <div class="success-icon success-icon--pending">✉</div>
    <h2>{confirmHeading}</h2>
    <p>{confirmText}</p>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-mailing-list-form]')) {
    const form = root.querySelector('[data-ml-form]') as HTMLFormElement | null;
    const errorEl = root.querySelector('[data-ml-error]') as HTMLElement | null;
    const successEl = root.querySelector('[data-ml-success]') as HTMLElement | null;
    const confirmEl = root.querySelector('[data-ml-confirm]') as HTMLElement | null;
    const submitBtn = root.querySelector('[data-ml-submit]') as HTMLButtonElement | null;
    if (!form || !errorEl || !successEl || !confirmEl || !submitBtn) continue;

    const volunteer = root.dataset.volunteer === 'true';
    const idleLabel = submitBtn.textContent ?? 'Subscribe';

    const value = (name: string) =>
      (form.querySelector(`[name="${name}"]`) as HTMLInputElement | null)?.value.trim() ?? '';

    function showError(msg: string) {
      errorEl!.textContent = msg;
      errorEl!.hidden = false;
    }

    function reset() {
      submitBtn!.disabled = false;
      submitBtn!.textContent = idleLabel;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.textContent = '';
      errorEl.hidden = true;

      const email = value('email');
      const consent = (form.querySelector('[name="consent"]') as HTMLInputElement | null)?.checked;

      if (!email) {
        showError('Please enter your email address.');
        return;
      }
      if (!consent) {
        showError("Please tick the box to confirm you'd like to receive emails.");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Signing you up…';

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            firstName: value('firstName'),
            lastName: value('lastName'),
            volunteer,
            website: value('website'),
          }),
        });
        const data = await res.json();

        if (data.success) {
          // A new address gets a confirmation email and is not on the list yet;
          // an address Brevo already knows is done. Saying "you're subscribed" to
          // the first would be a lie they only discover by never hearing from us.
          form.hidden = true;
          if (data.confirm) confirmEl.hidden = false;
          else successEl.hidden = false;
        } else {
          showError(data.error ?? 'Something went wrong. Please try again.');
          reset();
        }
      } catch {
        showError('Could not connect. Please check your connection and try again.');
        reset();
      }
    });
  }
</script>

<style>
  .ml-form {
    max-width: 480px;
  }

  .field-row {
    margin-bottom: var(--space-5);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg);
  }

  .optional {
    font-weight: 400;
    color: var(--fg-mute);
  }

  .required {
    color: #c0392b;
  }

  input[type="email"],
  input[type="text"] {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--fg);
    background: var(--bone);
    border: 1.5px solid var(--paper-deep);
    border-radius: var(--r-md);
    padding: 11px 14px;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s ease;
    outline: none;
  }

  input[type="email"]:focus,
  input[type="text"]:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(116, 169, 83, 0.18);
  }

  input[type="email"]::placeholder,
  input[type="text"]::placeholder {
    color: var(--ink-mute);
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--fg-soft);
    cursor: pointer;
    line-height: 1.5;
  }

  .checkbox-label input[type="checkbox"] {
    margin-top: 2px;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    accent-color: var(--green);
    cursor: pointer;
  }

  .checkbox-label a {
    color: var(--green-dark);
  }

  .form-message {
    font-size: 0.875rem;
    border-radius: var(--r-md);
    padding: 10px 14px;
    margin-bottom: var(--space-5);
  }

  .form-message--error {
    background: #fdf0ee;
    color: #a93226;
    border: 1px solid #f0b8b2;
  }

  [data-ml-submit] {
    margin-top: var(--space-5);
  }

  [data-ml-submit]:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Off-screen rather than display:none: some bots skip anything set to none. */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .success-wrap {
    padding: var(--space-6) 0;
  }

  .success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    font-size: 1.5rem;
    margin-bottom: var(--space-5);
  }

  .success-icon--pending {
    background: var(--green-dark);
  }

  .success-wrap h2 {
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.02em;
  }

  .success-wrap p {
    color: var(--fg-soft);
    margin: 0;
  }
</style>
