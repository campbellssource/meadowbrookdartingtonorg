---
import Layout from '../../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const allFacilities = await reader.collections.facilities.all();
---

<Layout title="Facilities" description="Explore the facilities at Meadowbrook Dartington">
  <h1>Our Facilities</h1>
  <p class="intro">
    Meadowbrook offers a variety of facilities for the Dartington community.
    Some facilities can be booked online - look for the "Bookable" badge.
  </p>

  <div class="facility-grid">
    {allFacilities.map(({ slug, entry }) => (
      <a href={`/facilities/${slug}`} class="facility-card">
        <div class="facility-image" style={`background-image: url(${entry.image ?? ''})`}>
          {entry.facilityType.discriminant === 'bookable' && <span class="badge">Bookable</span>}
        </div>
        <div class="facility-content">
          <h2>{entry.name}</h2>
          <p>{entry.shortDescription}</p>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  h1 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    color: #555;
  }

  .facility-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .facility-card {
    display: block;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .facility-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    text-decoration: none;
  }

  .facility-image {
    height: 200px;
    background-size: cover;
    background-position: center;
    background-color: #e0e0e0;
    position: relative;
  }

  .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--color-primary);
    color: white;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .facility-content {
    padding: 1.5rem;
  }

  .facility-content h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .facility-content p {
    color: #666;
    line-height: 1.5;
  }
</style>
