---
import Layout from '../../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import { zoneFor } from '../../lib/zones';

const reader = createReader(process.cwd(), keystaticConfig);
const allFacilities = await reader.collections.facilities.all();
---

<Layout title="Facilities" description="Explore the facilities at Meadowbrook Dartington">
  <section class="mw-sect">
    <div class="mw-wrap">
      <div class="mw-sect-head">
        <div>
          <span class="mw-eyebrow">Facilities</span>
          <h2>Pick your zone.</h2>
        </div>
        <div class="right">
          Some you can book online; some you turn up to; some you just wander into. Look for "Bookable" on the cards.
        </div>
      </div>

      <div class="mw-grid-3">
        {allFacilities.map(({ slug, entry }) => (
          <a href={`/facilities/${slug}`} class="mw-card">
            <div class="img" style={entry.image ? `background-image: url(${entry.image})` : ''}>
              {entry.facilityType.discriminant === 'bookable' && <span class="badge">Bookable</span>}
              {entry.facilityType.discriminant === 'link' && <span class="badge">Off-site</span>}
            </div>
            <div class="body">
              <h3>{entry.name}</h3>
              {entry.shortDescription && <p>{entry.shortDescription}</p>}
              <span class="meta">
                {entry.facilityType.discriminant === 'bookable' ? 'Book online' : entry.facilityType.discriminant === 'link' ? 'Visit website' : 'Find out more'}
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="mw-sect-head" style="margin-top: var(--space-9);">
        <div>
          <span class="mw-eyebrow">By zone</span>
          <h2>A flavour of each.</h2>
        </div>
      </div>
      <div class="mw-grid-4">
        {allFacilities.map(({ slug, entry }) => (
          <a href={`/facilities/${slug}`} class={`mw-zone-tile ${zoneFor(slug)}`}>
            <span class="eyebrow">{entry.facilityType.discriminant === 'bookable' ? 'Bookable' : entry.facilityType.discriminant === 'link' ? 'On site' : 'Explore'}</span>
            <h3>{entry.name}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
