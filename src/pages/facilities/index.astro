---
import Layout from '../../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import { zoneFor } from '../../lib/zones';

const reader = createReader(process.cwd(), keystaticConfig);
const allFacilities = await reader.collections.facilities.all();
const sorted = [...allFacilities].sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99));
---

<Layout title="Facilities" description="Explore the facilities at Meadowbrook Dartington">
  <section class="mw-sect">
    <div class="mw-wrap">
      <div class="mw-sect-head">
        <div>
          <span class="mw-eyebrow">Meadowbrook</span>
          <h2>Facilities.</h2>
        </div>
        <div class="right">
          Business that run from Meadowbrook, facilities and about the local area
        </div>
      </div>

      <div class="mw-grid-4">
        {sorted.map(({ slug, entry }) => {
          const isLink = entry.facilityType.discriminant === 'link';
          const isBookable = entry.facilityType.discriminant === 'bookable';
          const href = isLink ? (entry.facilityType.value as any).externalUrl : `/facilities/${slug}`;
          const imageSrc = entry.image
            ? (entry.image.startsWith('/') ? entry.image : `/images/facilities/${entry.image}`)
            : null;
          return (
            <a
              href={href}
              class={`mw-zone-tile ${zoneFor(slug)} ${slug}${imageSrc ? ' has-photo' : ''}`}
              {...(isLink ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {imageSrc && <div class="tile-photo" style={`background-image: url('${imageSrc}')`}></div>}
              {isBookable && <span class="tile-pill">Book now</span>}
              <h3>{entry.name}</h3>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
