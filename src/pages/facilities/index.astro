---
import Layout from '../../layouts/Layout.astro';

const facilities = [
  { 
    name: 'Swimming Pool', 
    slug: 'pool', 
    image: '/images/pool.jpg', 
    description: 'Our community pool is currently being restored. Follow our progress!',
    bookable: false
  },
  { 
    name: 'Bike Track', 
    slug: 'bike-track', 
    image: '/images/bike-track.jpg', 
    description: 'BMX and cycling track open to the community.',
    bookable: false
  },
  { 
    name: 'Snooker Room', 
    slug: 'snooker-room', 
    image: '/images/snooker.jpg', 
    description: 'Full-size snooker table available for booking.',
    bookable: true
  },
  { 
    name: 'Studio - Large Room', 
    slug: 'large-room', 
    image: '/images/large-room.jpg', 
    description: 'Ideal for classes, workshops, meetings and community events.',
    bookable: true
  },
  { 
    name: 'Lounge - Small Room', 
    slug: 'small-room', 
    image: '/images/small-room.jpg', 
    description: 'Perfect for smaller gatherings and meetings.',
    bookable: true
  },
  { 
    name: 'Playground', 
    slug: 'playground', 
    image: '/images/playground.jpg', 
    description: 'Outdoor play area for children of all ages.',
    bookable: false
  },
  { 
    name: 'Playing Fields', 
    slug: 'playing-fields', 
    image: '/images/fields.jpg', 
    description: 'Football pitches and open green spaces.',
    bookable: false
  },
  { 
    name: 'Woodland and Brook', 
    slug: 'woodland-and-brook', 
    image: '/images/woodland.jpg', 
    description: 'Nature walks and wildlife areas.',
    bookable: false
  },
];
---

<Layout title="Facilities" description="Explore the facilities at Meadowbrook Dartington">
  <h1>Our Facilities</h1>
  <p class="intro">
    Meadowbrook offers a variety of facilities for the Dartington community. 
    Some facilities can be booked online - look for the "Bookable" badge.
  </p>

  <div class="facility-grid">
    {facilities.map((facility) => (
      <a href={`/facilities/${facility.slug}`} class="facility-card">
        <div class="facility-image" style={`background-image: url(${facility.image})`}>
          {facility.bookable && <span class="badge">Bookable</span>}
        </div>
        <div class="facility-content">
          <h2>{facility.name}</h2>
          <p>{facility.description}</p>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  h1 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    color: #555;
  }

  .facility-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .facility-card {
    display: block;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .facility-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    text-decoration: none;
  }

  .facility-image {
    height: 200px;
    background-size: cover;
    background-position: center;
    background-color: #e0e0e0;
    position: relative;
  }

  .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--color-primary);
    color: white;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .facility-content {
    padding: 1.5rem;
  }

  .facility-content h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .facility-content p {
    color: #666;
    line-height: 1.5;
  }
</style>
