---
// Deliberately NOT prerendered. This page embeds BookingWidget, which needs the
// PUBLIC_BOOKING_SQUARE_* values at *request* time. Prerendering evaluates the
// frontmatter during `npm run build` -- in CI, where those variables do not
// exist -- and bakes `undefined` into static HTML. That shipped on 2 Sep 2026 and
// broke the live payment form with "undefined is not an object (evaluating
// 'e.length')", because Square's SDK was handed an undefined application ID.
// test/astro-prerender-env.test.ts guards this.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import { getRoomConfig } from '../../lib/booking/config-reader.ts';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import { DocumentRenderer } from '@keystatic/core/renderer';
import { zoneFor } from '../../lib/zones';

const { slug } = Astro.params;
const reader = createReader(process.cwd(), keystaticConfig);
const facility = await reader.collections.facilities.read(slug);

if (!facility) {
  return Astro.redirect('/404');
}

const { discriminant, value } = facility.facilityType;

const introNodes = await (value as any).intro();
const bodyNodes = (discriminant === 'generic' || discriminant === 'bookable') ? await (value as any).body() : null;
const amenities: string[] = discriminant === 'bookable' ? (value as any).amenities : [];
const secondImage: string | null = discriminant === 'bookable' ? ((value as any).secondImage ?? null) : null;
// Bookable here means "has a `booking` block in Keystatic and is active". Until a
// room is configured the section does not render at all, so a half-set-up room
// cannot take money.
const bookingRoom = discriminant === 'bookable' && slug ? await getRoomConfig(slug) : null;
const externalUrl: string = discriminant === 'link' ? (value as any).externalUrl : '';

const zone = zoneFor(slug);

const address = {
  "@type": "PostalAddress",
  streetAddress: "Shinners Bridge",
  addressLocality: "Dartington",
  addressRegion: "Devon",
  postalCode: "TQ9 6JD",
  addressCountry: "GB",
};

const structuredDataMap: Record<string, Record<string, unknown>> = {
  'snooker-room': {
    "@context": "https://schema.org",
    "@type": "SportsActivityLocation",
    name: "Snooker Room — Meadowbrook Dartington",
    description: "Full-size snooker table available to hire by the hour in Dartington, near Totnes. Cues and equipment included. Drinks available from the bar downstairs when open.",
    url: "https://meadowbrookdartington.org/facilities/snooker-room",
    address,
    sport: "Snooker",
    containedInPlace: {
      "@type": "CivicStructure",
      name: "Meadowbrook",
      address,
    },
  },
  'large-room': {
    "@context": "https://schema.org",
    "@type": "SportsActivityLocation",
    name: "Studio — Meadowbrook Dartington",
    description: "Versatile 75 m² studio and events space with high vaulted ceiling in Dartington, near Totnes. Ideal for yoga, martial arts, dance, meetings and events. Parquet floor section and full-length wall-mounted barre included.",
    url: "https://meadowbrookdartington.org/facilities/large-room",
    address,
    sport: ["Yoga", "Martial Arts", "Dance"],
    containedInPlace: {
      "@type": "CivicStructure",
      name: "Meadowbrook",
      address,
    },
  },
  'small-room': {
    "@context": "https://schema.org",
    "@type": "MeetingRoom",
    name: "Lounge — Meadowbrook Dartington",
    description: "Comfortable lounge space available to hire in Dartington, near Totnes. Ideal for small presentations, meetings, and private gatherings. Kitchen access included.",
    url: "https://meadowbrookdartington.org/facilities/small-room",
    address,
    containedInPlace: {
      "@type": "CivicStructure",
      name: "Meadowbrook",
      address,
    },
  },
};

const structuredData = structuredDataMap[slug] ?? undefined;
---

<Layout
  title={facility.name}
  description={facility.shortDescription ?? undefined}
  ogImage={`/images/facilities/${slug}-og.jpg`}
  bodyClass={`zone-${zone}`}
  structuredData={structuredData}
>
  <section class="mw-zone-hero">
    <div class="mw-wrap">
      <span class="mw-eyebrow">
        {discriminant === 'bookable' ? 'Bookable space' : discriminant === 'link' ? 'On site' : 'Facility'}
      </span>
      <h1>{facility.name}</h1>
      {facility.shortDescription && <p>{facility.shortDescription}</p>}
      {discriminant === 'link' && externalUrl && (
        <a href={externalUrl} class="mw-btn mw-btn-ink" target="_blank" rel="noopener">Visit website</a>
      )}
      {discriminant === 'bookable' && (
        <a href="#book" class="mw-btn mw-btn-ink">Check availability</a>
      )}
    </div>
  </section>

  <section class="mw-sect" style="background: var(--bg-elevated, var(--paper));">
    <div class="mw-wrap" style={facility.image ? "display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-7); align-items: start;" : ""}>
      <div class="mw-article" style="margin: 0; padding: 0; max-width: 60ch;">
        <DocumentRenderer document={introNodes} />

        {discriminant === 'bookable' && amenities.length > 0 && (
          <>
            <h2 style="margin-top: var(--space-6);">Amenities</h2>
            <ul class="mw-amenities">
              {amenities.map((amenity) => (
                <li>{amenity}</li>
              ))}
            </ul>
          </>
        )}
      </div>

      {facility.image && (
        <div style="display: flex; flex-direction: column; gap: var(--space-4);">
          <img src={facility.image} alt={facility.name} style="width: 100%; border-radius: var(--r-lg); aspect-ratio: 4/3; object-fit: cover;" />
          {secondImage && (
            <img src={secondImage} alt={facility.name} style="width: 100%; border-radius: var(--r-lg); aspect-ratio: 4/3; object-fit: cover;" />
          )}
        </div>
      )}
    </div>
  </section>

  {discriminant === 'bookable' && bodyNodes && (
    <section class="mw-sect">
      <div class="mw-wrap">
        <div class="mw-article mw-article--facility-body" style="margin: 0;">
          <DocumentRenderer document={bodyNodes} />
        </div>
      </div>
    </section>
  )}

  {bookingRoom && (
    <section class="mw-sect" id="book">
      <div class="mw-wrap">
        <BookingWidget room={bookingRoom} />
      </div>
    </section>
  )}

  {discriminant === 'link' && externalUrl && (
    <section class="mw-sect">
      <div class="mw-wrap">
        <div class="mw-banner">
          <div>
            <span class="mw-eyebrow">Visit</span>
            <h3>Run by the team at {new URL(externalUrl).hostname.replace(/^www\./, '')}</h3>
            <p>This space is operated independently. Head to their website for opening hours, prices and booking.</p>
            <a href={externalUrl} class="mw-btn mw-btn-primary" target="_blank" rel="noopener">Visit website</a>
          </div>
          <div class="visual" style={`background-image: url('${facility.image ?? '/assets/photos/hero.webp'}');`}></div>
        </div>
      </div>
    </section>
  )}

  {discriminant === 'generic' && bodyNodes && (
    <section class="mw-sect">
      <div class="mw-wrap">
        <div class="mw-article" style="margin: 0;">
          <DocumentRenderer document={bodyNodes} />
        </div>
      </div>
    </section>
  )}

  <section class="mw-sect tight">
    <div class="mw-wrap">
      <a href="/facilities" class="mw-back">Back to all facilities</a>
    </div>
  </section>
</Layout>

<style>
  .mw-article--facility-body img {
    width: 100%;
    border-radius: var(--r-lg);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    margin-top: var(--space-5);
  }
</style>
