---
import Layout from '../../layouts/Layout.astro';
import RaffleLegal from '../../components/RaffleLegal.astro';
import {
  TICKET_PRICE_PENNIES,
  TICKET_PRICE_LABEL,
  MAX_QUANTITY,
  DRAW_DATE_LABEL,
  DRAW_WHEN_LABEL,
  raffleSquareConfig,
  entryDeadlineStatus,
  formatDeadline,
  type DeadlineStatus,
} from '../../lib/raffle';
import { getPrizes, getEntryDeadlineRaw, isRaffleSheetConfigured } from '../../lib/raffle-sheet';

// The raffle is Extravaganza-only, so it wears the event's festival micro-brand
// (bodyClass="zone-extravaganza"): orange field, Poppins caps, bunting. See
// src/pages/calendar/extravaganza2026.astro for the shared fixtures.

// Square (raffle sandbox). appId + locationId are public; the access token is
// server-only and never reaches the client bundle.
const sq = raffleSquareConfig();
const squareSdkUrl = sq.environment === 'production'
  ? 'https://web.squarecdn.com/v1/square.js'
  : 'https://sandbox.web.squarecdn.com/v1/square.js';

const configured = isRaffleSheetConfigured();
let prizes: Awaited<ReturnType<typeof getPrizes>> = [];
let deadline: DeadlineStatus = { hasDeadline: false, closed: false, at: null };
let loadError = false;
if (configured) {
  try {
    prizes = await getPrizes();
    deadline = entryDeadlineStatus(await getEntryDeadlineRaw());
  } catch (err) {
    console.error('raffle: load failed', err);
    loadError = true;
  }
}

// getPrizes returns star-first; split the headline prize out for special treatment.
const starPrize = prizes.find((p) => p.star) ?? null;
const otherPrizes = prizes.filter((p) => p !== starPrize);
const entriesClosed = deadline.closed;

const bunt = ['sky', 'pink', 'sun', 'teal', 'green', 'orange'];
const buntRow = (n: number) => Array.from({ length: n }, (_, i) => bunt[i % bunt.length]);
---

<Layout
  title="Extravaganza Raffle"
  description={`Win great prizes and support the Meadowbrook pool. ${TICKET_PRICE_LABEL} a ticket. Winners drawn live at the Extravaganza on ${DRAW_DATE_LABEL} — you don't need to be there to win.`}
  ogImage="/images/events/raffle/image.jpg"
  bodyClass="zone-extravaganza"
  noindex={true}
>
  <div class="ex-bunt-band down" aria-hidden="true">
    {buntRow(24).map((c) => <i style={`background: var(--bunt-${c})`}></i>)}
  </div>

  <!-- HERO -->
  <section class="mw-sect rf-hero">
    <div class="mw-wrap">
      <div class="ex-stamp">
        <img src="/assets/logos/hand.png" alt="Meadowbrook + DRA hand mark" />
        <span>Meadowbrook</span>
      </div>
      <h1 class="ex-wordmark">Raffle</h1>
      <p class="ex-sub">Win big at the Extravaganza</p>
      <p class="rf-lead">
        Grab a ticket, support the community pool we're working to bring back, and you could
        win one of our prizes — drawn live on the loudspeaker at <strong>{DRAW_WHEN_LABEL}</strong>.
      </p>
      <div class="rf-price-badge">
        <span class="rf-price">{TICKET_PRICE_LABEL}</span>
        <span class="rf-price-per">per ticket</span>
      </div>
      <p class="rf-everyprize">Every ticket is in the draw for <strong>every</strong> prize — you don't need to be there to win.</p>
      <a class="rf-seeall" href="/entries">See all entries →</a>
    </div>
  </section>

  <!-- PRIZES -->
  <section class="mw-sect tight">
    <div class="mw-wrap">
      <h2 class="ex-h2">The prizes</h2>
      {prizes.length === 0 && <p class="rf-empty">Prizes are being confirmed — check back soon.</p>}

      {starPrize && (
        <div class="rf-star">
          <span class="rf-star-ribbon">★ Star prize</span>
          <h3>{starPrize.name}</h3>
          {starPrize.description && <p class="rf-star-desc">{starPrize.description}</p>}
          {starPrize.donor && (
            <p class="rf-prize-donor">
              Kindly donated by {starPrize.donorUrl
                ? <a href={starPrize.donorUrl} target="_blank" rel="noopener">{starPrize.donor}</a>
                : starPrize.donor}
            </p>
          )}
        </div>
      )}

      {otherPrizes.length > 0 && (
        <ul class="rf-prizes">
          {otherPrizes.map((p) => (
            <li class="rf-prize">
              <h3>{p.name}</h3>
              {p.description && <p class="rf-prize-desc">{p.description}</p>}
              {p.donor && (
                <p class="rf-prize-donor">
                  Kindly donated by {p.donorUrl
                    ? <a href={p.donorUrl} target="_blank" rel="noopener">{p.donor}</a>
                    : p.donor}
                </p>
              )}
            </li>
          ))}
        </ul>
      )}
      {prizes.length > 0 && (
        <p class="rf-prize-note">
          You don't choose a prize — we run a separate draw for each one, and any of your tickets
          could win. The star prize is drawn last.
        </p>
      )}
    </div>
  </section>

  <!-- ENTRY FORM -->
  <section class="mw-sect tight" id="enter">
    <div class="mw-wrap rf-form-wrap">
      <h2 class="ex-h2">Enter the raffle</h2>

      {!configured || loadError ? (
        <div class="rf-card rf-notice">
          The raffle isn't available right now. Please try again later, or
          <a href="/contact">get in touch</a>.
        </div>
      ) : entriesClosed ? (
        <div class="rf-card rf-notice">
          <strong>Entries have now closed.</strong> The draw is live on the loudspeaker at
          {' '}{DRAW_WHEN_LABEL}. You can still <a href="/entries">see all the entries</a>.
        </div>
      ) : (
        <div class="rf-card">
          {deadline.hasDeadline && deadline.at && (
            <p class="rf-deadline">Entries close <strong>{formatDeadline(deadline.at)}</strong>.</p>
          )}
          <form id="rf-form" novalidate>
            <div class="rf-field">
              <label for="rf-name">Your name</label>
              <input id="rf-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="rf-field">
              <label for="rf-email">Email</label>
              <input id="rf-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="rf-field">
              <label for="rf-phone">Phone</label>
              <input id="rf-phone" name="phone" type="tel" autocomplete="tel" required />
              <p class="rf-hint">So we can reach you if you win.</p>
            </div>
            <div class="rf-field">
              <label for="rf-qty">Number of tickets</label>
              <input id="rf-qty" name="quantity" type="number" min="1" max={MAX_QUANTITY} value="1" inputmode="numeric" required />
            </div>

            <div class="rf-total-row">
              <span>Total</span>
              <span class="rf-total" id="rf-total">{TICKET_PRICE_LABEL}</span>
            </div>

            <label class="rf-consent">
              <input id="rf-consent" name="consent" type="checkbox" required />
              <span>
                I agree that the Dartington Recreation Association may hold my details to run this
                raffle and contact me if I win. See the
                <a href="/privacy" target="_blank" rel="noopener">privacy policy</a>.
              </span>
            </label>

            <div id="rf-error" class="rf-message rf-message--error" hidden></div>

            <button type="submit" id="rf-submit" class="mw-btn rf-submit">
              Continue to payment <span id="rf-btn-total">{TICKET_PRICE_LABEL}</span>
            </button>
          </form>

          <!-- Payment step: revealed after the entry is created. -->
          <div id="rf-pay" class="rf-pay" hidden>
            <p class="rf-pay-summary">You're buying <strong id="rf-pay-summary">…</strong></p>
            <label class="rf-pay-label">Card details</label>
            <div id="rf-card-container"></div>
            <p class="rf-hint">Payments are processed securely by Square. We never store your card details.</p>
            <p class="rf-sandbox-note">Test mode — use card <code>4111 1111 1111 1111</code>, any future expiry, any CVV, any postcode.</p>

            <div id="rf-pay-error" class="rf-message rf-message--error" hidden></div>

            <button type="button" id="rf-pay-btn" class="mw-btn rf-submit" disabled>
              Pay <span id="rf-pay-btn-total">…</span>
            </button>
          </div>

          <!-- Confirmation: shown once tickets are minted. -->
          <div id="rf-done" class="rf-pay" hidden>
            <div class="rf-pay-icon">✓</div>
            <h3>You're in the draw!</h3>
            <p id="rf-done-lead">Your ticket numbers:</p>
            <ul id="rf-tickets" class="rf-tickets"></ul>
            <p class="rf-done-note">
              Every ticket is entered in the draw for <strong>every</strong> prize. Winners are
              drawn live at the Extravaganza on {DRAW_DATE_LABEL}.
            </p>
            <a href="/entries" class="rf-seeall rf-seeall--ink">See your tickets on the entries page →</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- HOW THE DRAW WORKS -->
  <section class="mw-sect tight">
    <div class="mw-wrap rf-how">
      <h2 class="ex-h2">How the draw works</h2>
      <ul class="rf-how-list">
        <li><strong>You don't pick a prize.</strong> We run a separate draw for each prize, in turn, working up to the star prize which is drawn last.</li>
        <li>Every ticket goes into every draw. A ticket that wins is taken out, so one ticket wins at most one prize — but if you hold several tickets, each still has its own chances.</li>
        <li>The draw is <strong>live on the loudspeaker at {DRAW_WHEN_LABEL}</strong>. You <strong>don't need to be there</strong> — if you're not around when your ticket wins, we'll email you to arrange collection.</li>
        <li>Every ticket is listed on the public <a href="/entries">entries page</a>, so you can check yours is really in before the draw.</li>
        <li>Winners are picked by a cryptographically secure random selection (<code>crypto.randomInt</code>), and the number of tickets in each draw is announced as the winner is picked.</li>
      </ul>
    </div>
  </section>

  <!-- LEGAL -->
  <section class="mw-sect tight">
    <div class="mw-wrap"><RaffleLegal /></div>
  </section>

  <div class="ex-bunt-band up" aria-hidden="true">
    {buntRow(24).map((c) => <i style={`background: var(--bunt-${c})`}></i>)}
  </div>
</Layout>

<!-- Square Web Payments SDK (sandbox or production per env) -->
<script src={squareSdkUrl} is:inline></script>

<script define:vars={{ pricePennies: TICKET_PRICE_PENNIES, maxQty: MAX_QUANTITY, squareAppId: sq.appId, squareLocationId: sq.locationId }}>
  const form = document.getElementById('rf-form');
  if (form) {
    const qtyInput = document.getElementById('rf-qty');
    const totalEl = document.getElementById('rf-total');
    const btnTotalEl = document.getElementById('rf-btn-total');
    const errorEl = document.getElementById('rf-error');
    const submitBtn = document.getElementById('rf-submit');

    const payEl = document.getElementById('rf-pay');
    const paySummary = document.getElementById('rf-pay-summary');
    const payBtn = document.getElementById('rf-pay-btn');
    const payBtnTotal = document.getElementById('rf-pay-btn-total');
    const payErrorEl = document.getElementById('rf-pay-error');
    const doneEl = document.getElementById('rf-done');
    const doneLead = document.getElementById('rf-done-lead');
    const ticketsEl = document.getElementById('rf-tickets');

    const fmt = (pence) => (pence % 100 === 0 ? `£${pence / 100}` : `£${(pence / 100).toFixed(2)}`);

    function currentQty() {
      let q = Math.floor(Number(qtyInput.value));
      if (!Number.isFinite(q)) q = 1;
      return Math.min(Math.max(q, 1), maxQty);
    }
    function updateTotal() {
      const label = fmt(currentQty() * pricePennies);
      if (totalEl) totalEl.textContent = label;
      if (btnTotalEl) btnTotalEl.textContent = label;
    }
    function showError(el, msg) { if (el) { el.textContent = msg; el.hidden = false; } }
    function clearError(el) { if (el) { el.hidden = true; el.textContent = ''; } }

    qtyInput?.addEventListener('input', updateTotal);
    updateTotal();

    let paymentId = null;
    let card = null;

    // Mount the Square card element once, when the pay step is first shown.
    async function initCard() {
      if (card) return true;
      if (!squareAppId || !squareLocationId || typeof Square === 'undefined') {
        showError(payErrorEl, 'Card payments are not available right now. Please get in touch to enter.');
        return false;
      }
      const payments = await Square.payments(squareAppId, squareLocationId);
      card = await payments.card({
        style: {
          '.input-container': { borderColor: '#e6dccb', borderRadius: '10px' },
          '.input-container.is-focus': { borderColor: '#F47B1F' },
          '.input-container.is-error': { borderColor: '#c0392b' },
          input: { color: '#28201A', fontFamily: 'inherit' },
          'input::placeholder': { color: '#8B7C6E' },
        },
      });
      await card.attach('#rf-card-container');
      return true;
    }

    // Step 1 — create the pending entry, then reveal the card.
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError(errorEl);

      const payload = {
        name: document.getElementById('rf-name').value.trim(),
        email: document.getElementById('rf-email').value.trim(),
        phone: document.getElementById('rf-phone').value.trim(),
        quantity: currentQty(),
        consent: document.getElementById('rf-consent').checked,
      };
      if (!payload.name) return showError(errorEl, 'Please enter your name.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email)) return showError(errorEl, 'Please enter a valid email address.');
      if (!payload.phone) return showError(errorEl, 'Please enter a phone number so we can reach you if you win.');
      if (!payload.consent) return showError(errorEl, 'Please tick the consent box to enter.');

      submitBtn.disabled = true;
      submitBtn.textContent = 'Just a moment…';

      try {
        const res = await fetch('/api/raffle/entry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) {
          showError(errorEl, data.error ?? 'Something went wrong. Please try again.');
          submitBtn.disabled = false;
          submitBtn.innerHTML = `Continue to payment <span id="rf-btn-total">${fmt(currentQty() * pricePennies)}</span>`;
          return;
        }
        paymentId = data.paymentId;
        const label = fmt(data.amountPennies);
        if (paySummary) paySummary.textContent = `${data.quantity} ticket${data.quantity > 1 ? 's' : ''} · ${label}`;
        if (payBtnTotal) payBtnTotal.textContent = label;
        form.hidden = true;
        if (payEl) payEl.hidden = false;
        const ok = await initCard();
        if (payBtn) payBtn.disabled = !ok;
      } catch {
        showError(errorEl, 'Could not connect. Please check your connection and try again.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = `Continue to payment <span id="rf-btn-total">${fmt(currentQty() * pricePennies)}</span>`;
      }
    });

    // Step 2 — tokenise the card and charge it.
    payBtn?.addEventListener('click', async () => {
      clearError(payErrorEl);
      if (!card || !paymentId) return;

      payBtn.disabled = true;
      const restore = payBtn.innerHTML;
      payBtn.textContent = 'Processing…';

      let token;
      try {
        const result = await card.tokenize();
        if (result.status !== 'OK') {
          showError(payErrorEl, result.errors?.[0]?.message ?? 'Please check your card details and try again.');
          payBtn.disabled = false; payBtn.innerHTML = restore;
          return;
        }
        token = result.token;
      } catch {
        showError(payErrorEl, 'Could not read your card. Please try again.');
        payBtn.disabled = false; payBtn.innerHTML = restore;
        return;
      }

      try {
        const res = await fetch('/api/raffle/pay', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ paymentId, sourceId: token }),
        });
        const data = await res.json();
        if (data.success) {
          const tickets = data.tickets ?? [];
          if (doneLead) doneLead.textContent = tickets.length > 1 ? 'Your ticket numbers:' : 'Your ticket number:';
          if (ticketsEl) ticketsEl.innerHTML = tickets.map((t) => `<li>${t}</li>`).join('');
          if (payEl) payEl.hidden = true;
          if (doneEl) doneEl.hidden = false;
        } else {
          showError(payErrorEl, data.error ?? 'Payment failed. Please try again.');
          payBtn.disabled = false; payBtn.innerHTML = restore;
        }
      } catch {
        showError(payErrorEl, 'Could not connect. Please try again.');
        payBtn.disabled = false; payBtn.innerHTML = restore;
      }
    });
  }
</script>

<style>
  /* Rides on .zone-extravaganza (festival orange field, white text). */

  .ex-bunt-band { display: flex; height: 46px; width: 100%; }
  .ex-bunt-band i { flex: 1 1 0; display: block; }
  .ex-bunt-band.down i { clip-path: polygon(0 0, 100% 0, 50% 100%); }
  .ex-bunt-band.up i { clip-path: polygon(0 100%, 100% 100%, 50% 0); }

  .ex-stamp {
    display: inline-flex; align-items: center; gap: 14px;
    font-family: "Poppins", sans-serif; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; font-size: 1rem; color: #fff; margin-bottom: var(--space-5);
  }
  .ex-stamp img { height: 42px; width: auto; }
  .ex-wordmark {
    font-family: "Poppins", sans-serif; font-weight: 800; text-transform: uppercase;
    letter-spacing: -0.02em; line-height: 0.9;
    font-size: clamp(2.6rem, 8vw, 5rem); color: #fff; margin: 0;
  }
  .ex-sub {
    font-family: "Poppins", sans-serif; font-weight: 600;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem); color: #fff; margin: 12px 0 0;
  }
  .ex-h2 {
    font-family: "Poppins", sans-serif; font-weight: 800; text-transform: uppercase;
    letter-spacing: -0.01em; font-size: clamp(1.6rem, 4vw, 2.6rem);
    color: #fff; margin: 0 0 var(--space-5);
  }

  .rf-hero { padding-top: var(--space-7); }
  .rf-lead {
    font-size: 1.2rem; line-height: 1.6; color: #fff; font-weight: 500;
    max-width: 46ch; margin: var(--space-5) 0 0;
  }
  .rf-price-badge {
    display: inline-flex; align-items: baseline; gap: 8px;
    background: var(--sun); color: var(--ink); border-radius: var(--r-lg);
    padding: 10px 18px; margin: var(--space-5) 0 0;
  }
  .rf-price { font-family: "Poppins", sans-serif; font-weight: 800; font-size: 1.8rem; line-height: 1; }
  .rf-price-per { font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.8rem; }
  .rf-everyprize { color: #fff; font-size: 1.05rem; margin: var(--space-4) 0 0; }
  .rf-everyprize strong { color: var(--sun); }
  .rf-seeall {
    display: inline-block; margin-top: var(--space-4);
    font-family: "Poppins", sans-serif; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; font-size: 13px; color: var(--ink);
    text-decoration: underline; text-underline-offset: 0.3em;
  }

  /* Prizes */
  .rf-prizes {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-5);
  }
  .rf-prize {
    background: #fff; color: var(--ink); border-radius: var(--r-lg);
    padding: var(--space-5) var(--space-5) var(--space-6);
  }
  .rf-prize h3 { font-family: "Poppins", sans-serif; font-weight: 800; font-size: 1.15rem; margin: 0 0 8px; }
  .rf-prize-desc { margin: 0 0 10px; color: var(--ink-soft); line-height: 1.5; font-size: 0.95rem; }
  .rf-prize-donor { margin: 0; font-size: 0.8rem; font-weight: 600; color: var(--ink-mute); }
  .rf-prize-donor a { color: var(--bunt-orange, #F47B1F); text-decoration: underline; }
  .rf-empty { color: #fff; opacity: 0.9; }

  /* Star (headline) prize */
  .rf-star {
    position: relative; background: #fff; color: var(--ink);
    border: 3px solid var(--sun); border-radius: var(--r-lg);
    padding: var(--space-6) var(--space-6) var(--space-6);
    margin: 0 0 var(--space-5); box-shadow: 0 14px 40px rgba(40, 35, 32, 0.22);
  }
  .rf-star-ribbon {
    display: inline-block; background: var(--sun); color: var(--ink);
    font-family: "Poppins", sans-serif; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.05em; font-size: 0.72rem; padding: 5px 12px; border-radius: 999px;
    margin-bottom: var(--space-4);
  }
  .rf-star h3 { font-family: "Poppins", sans-serif; font-weight: 800; font-size: clamp(1.4rem, 3.4vw, 2rem); margin: 0 0 8px; letter-spacing: -0.01em; }
  .rf-star-desc { margin: 0 0 10px; color: var(--ink-soft); line-height: 1.55; font-size: 1.05rem; }

  .rf-prize-note { color: #fff; margin: var(--space-5) 0 0; font-size: 0.98rem; line-height: 1.6; max-width: 60ch; }

  .rf-deadline {
    margin: 0 0 var(--space-5); padding: 8px 12px; border-radius: var(--r-md, 10px);
    background: var(--bone, #faf6ef); color: var(--ink-soft); font-size: 0.9rem;
  }
  .rf-deadline strong { color: var(--ink); }

  /* Form card */
  .rf-form-wrap { max-width: 560px; }
  .rf-card {
    background: #fff; color: var(--ink); border-radius: var(--r-lg);
    padding: var(--space-7); box-shadow: 0 18px 44px rgba(40, 35, 32, 0.28);
  }
  .rf-field { margin-bottom: var(--space-5); }
  .rf-field label {
    display: block; font-family: "Poppins", sans-serif; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.72rem;
    color: var(--ink-soft); margin-bottom: 6px;
  }
  .rf-field input {
    width: 100%; font-family: var(--font-body); font-size: 1rem; color: var(--ink);
    background: var(--bone, #faf6ef); border: 1.5px solid var(--paper-deep, #e6dccb);
    border-radius: var(--r-md, 10px); padding: 12px 14px; outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .rf-field input:focus {
    border-color: var(--bunt-orange, #F47B1F);
    box-shadow: 0 0 0 3px rgba(244, 123, 31, 0.18);
  }
  .rf-hint { margin: 6px 0 0; font-size: 0.8rem; color: var(--ink-mute); }

  .rf-total-row {
    display: flex; justify-content: space-between; align-items: baseline;
    border-top: 1px solid var(--paper-deep, #e6dccb); padding-top: var(--space-4);
    margin-bottom: var(--space-5);
    font-family: "Poppins", sans-serif; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; font-size: 0.8rem; color: var(--ink-soft);
  }
  .rf-total { font-size: 1.5rem; letter-spacing: -0.01em; color: var(--ink); }

  .rf-consent {
    display: flex; gap: 10px; align-items: flex-start;
    font-size: 0.88rem; line-height: 1.5; color: var(--ink-soft); margin-bottom: var(--space-5);
  }
