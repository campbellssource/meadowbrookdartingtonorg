---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with the Dartington Recreation Association">
  <section class="mw-zone-hero">
    <div class="mw-wrap">
      <span class="mw-eyebrow">Get in touch</span>
      <h1>Say hello.</h1>
      <p>Questions, ideas, offers of help — we'd love to hear from you.</p>
    </div>
  </section>

  <section class="mw-sect" style="background: var(--bg-elevated);">
    <div class="mw-wrap">
      <span class="mw-eyebrow">By post or email</span>
      <h2 style="font-family: var(--font-body); font-weight: 700; font-size: 1.6rem; letter-spacing: -0.02em; margin: var(--space-2) 0 var(--space-5);">Find us</h2>
      <div class="mw-article" style="padding: 0;">
        <p><strong>Email</strong><br />
        <a href="mailto:contact@meadowbrookdartington.org">contact@meadowbrookdartington.org</a></p>

        <p><strong>Address</strong><br />
        Meadowbrook<br />
        Shinners Bridge<br />
        Dartington<br />
        TQ9 6JD</p>

        <p>
          <a href="https://maps.app.goo.gl/ngFR4nEtYtdYe3SG9" target="_blank" rel="noopener">View on Google Maps →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="mw-sect">
    <div class="mw-wrap">
      <div class="mw-map-block">
        <div class="picture">
          <img src="/assets/illustrations/map.png" alt="Hand-drawn map of Meadowbrook" />
        </div>
        <div class="copy">
          <span class="mw-eyebrow">The site</span>
          <h2>How it lays out.</h2>
          <p>The site sits at Shinners Bridge — cross the brook for the playing fields, bike track and woodland trails.</p>
          <a href="https://maps.app.goo.gl/ngFR4nEtYtdYe3SG9" class="mw-btn mw-btn-primary" target="_blank" rel="noopener">Open in Maps</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 900px) {
    section.mw-sect > .mw-wrap[style*="grid-template-columns: 1fr 1.1fr"] {
      grid-template-columns: 1fr !important;
      gap: var(--space-6) !important;
    }
  }
</style>
