---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import MailingListForm from '../components/MailingListForm.astro';
---

<Layout
  title="Subscribe to updates"
  description="Subscribe to updates from Meadowbrook and the DRA. Get notifications on upcoming events and news."
>
  <section class="mw-zone-hero" style="padding-bottom: var(--space-7);">
    <div class="mw-wrap">
      <span class="mw-eyebrow">Stay in the loop</span>
      <h1>Subscribe to updates</h1>
      <p>Get notifications on upcoming events, news from Meadowbrook, and updates from the Dartington Recreation Association.</p>
    </div>
  </section>

  <section class="mw-sect" style="padding-top: 0;">
    <div class="mw-wrap">
      <div class="subscribe-form-wrap">
        <MailingListForm />

        <div class="subscribe-social">
          <span class="subscribe-social-label">Prefer social? Follow along</span>
          <SocialLinks variant="inline" class="mw-socials-lg" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .subscribe-form-wrap {
    max-width: 480px;
  }

  .subscribe-social {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--paper-deep);
  }

  .subscribe-social-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: var(--space-4);
  }
</style>
