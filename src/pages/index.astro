---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { DocumentRenderer } from '@keystatic/core/renderer';

const reader = createReader(process.cwd(), keystaticConfig);

const homepage = await reader.singletons.homepage.read();
const allFacilities = await reader.collections.facilities.all();

const aboutPreviewNodes = homepage?.aboutPreview ? await homepage.aboutPreview() : null;
---

<Layout title="Home">
  <section class="hero">
    <h1>{homepage?.heroHeading ?? 'Welcome to Meadowbrook'}</h1>
    <p class="lead">{homepage?.heroSubtitle}</p>
    <a href="/about" class="btn">Learn More</a>
  </section>

  <section class="facilities">
    <h2>Our Facilities</h2>
    <div class="facility-grid">
      {allFacilities.map(({ slug, entry }) => (
        <a href={`/facilities/${slug}`} class="facility-card">
          <div class="facility-image" style={`background-image: url(${entry.image ?? ''})`}>
            {entry.facilityType.discriminant === 'bookable' && <span class="badge">Bookable</span>}
          </div>
          <h3>{entry.name}</h3>
          <p>{entry.shortDescription}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="about-preview">
    <h2>About Meadowbrook</h2>
    {aboutPreviewNodes && <DocumentRenderer document={aboutPreviewNodes} />}
    <a href="/about" class="btn-secondary">About the DRA</a>
  </section>

  <section class="partners">
    <h2>In Partnership With</h2>
    {homepage?.partnersIntro && <p class="partners-intro">{homepage.partnersIntro}</p>}
    <div class="partner-logos">
      <a href="https://www.dartington.org/"><img src="/images/partners/dartington.png" alt="Dartington Hall Trust" /></a>
      <a href="https://bidwellbrook.org/"><img src="/images/partners/bidwell-brook.png" alt="Bidwell Brook School" /></a>
      <a href="https://www.sportengland.org/"><img src="/images/partners/sport-england.png" alt="Sport England" /></a>
      <a href="https://lifeworks-uk.org/"><img src="/images/partners/lifeworks.png" alt="Lifeworks" /></a>
    </div>
  </section>

  {homepage?.banners && homepage.banners.length > 0 && (
    <section class="banners">
      {homepage.banners.map((banner) => (
        <div class="banner">
          <h3>{banner.title}</h3>
          <p>{banner.body}</p>
          {banner.link && (
            <a href={banner.link} class="btn">{banner.linkLabel || 'Learn more'}</a>
          )}
        </div>
      ))}
    </section>
  )}
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, #f0f7f0 0%, #e8f4e8 100%);
    border-radius: 12px;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .lead {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto 2rem;
    color: #555;
  }

  .btn {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .btn:hover {
    opacity: 0.9;
    text-decoration: none;
  }

  .btn-secondary {
    display: inline-block;
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 500;
    text-decoration: none;
  }

  section {
    margin-bottom: 4rem;
  }

  section h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    color: var(--color-primary);
  }

  .facility-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .facility-card {
    display: block;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .facility-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    text-decoration: none;
  }

  .facility-image {
    height: 180px;
    background-size: cover;
    background-position: center;
    background-color: #e0e0e0;
    position: relative;
  }

  .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--color-primary);
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .facility-card h3 {
    padding: 1rem 1rem 0.5rem;
    font-size: 1.1rem;
  }

  .facility-card p {
    padding: 0 1rem 1rem;
    color: #666;
    font-size: 0.9rem;
  }

  .about-preview {
    background: #f9f9f9;
    padding: 2rem;
    border-radius: 12px;
  }

  .about-preview p {
    max-width: 700px;
    margin-bottom: 1.5rem;
  }

  .partners-intro {
    margin-bottom: 1.5rem;
    color: #555;
  }

  .partner-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    justify-content: center;
  }

  .partner-logos img {
    height: 60px;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .partner-logos a:hover img {
    opacity: 1;
  }

  .banners {
    display: grid;
    gap: 1.5rem;
  }

  .banner {
    background: #f0f7f0;
    padding: 1.5rem 2rem;
    border-radius: 12px;
    border-left: 4px solid var(--color-primary);
  }

  .banner h3 {
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .banner p {
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 1.75rem;
    }

    .lead {
      font-size: 1rem;
    }
  }
</style>
