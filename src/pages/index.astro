---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { DocumentRenderer } from '@keystatic/core/renderer';
import { zoneFor } from '../lib/zones';

const reader = createReader(process.cwd(), keystaticConfig);

const homepage = await reader.singletons.homepage.read();

const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingEvents = (await reader.collections.events.all())
  .filter(({ entry }) => entry.date && new Date(entry.date + 'T12:00:00') >= today)
  .sort((a, b) =>
    new Date(a.entry.date! + 'T12:00:00').getTime() -
    new Date(b.entry.date! + 'T12:00:00').getTime()
  )
  .slice(0, 4);

function formatEventDate(dateStr: string) {
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
}
function shortDate(dateStr: string) {
  const d = new Date(dateStr + 'T12:00:00');
  return {
    day: d.toLocaleDateString('en-GB', { day: 'numeric' }),
    mon: d.toLocaleDateString('en-GB', { month: 'short' }),
  };
}

const allPartners = (await reader.collections.partners.all())
  .sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99));

const allSupporters = (await reader.collections.supporters.all())
  .sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99));

const allFacilities = (await reader.collections.facilities.all())
  .sort((a, b) => (a.entry.order ?? 99) - (b.entry.order ?? 99));

const aboutPreviewNodes = homepage?.aboutPreview ? await homepage.aboutPreview() : null;
const introTextNodes = homepage?.introText ? await homepage.introText() : null;

const energyHubImageSrc = homepage?.energyHubImage
  ? (homepage.energyHubImage.startsWith('/') ? homepage.energyHubImage : `/images/energy-hub/${homepage.energyHubImage}`)
  : '/images/energy-hub/image+30.png.webp';
---

<Layout title="Home" navOnPhoto>
  <section class="mw-hero">
    <div class="photo" style="background-image: url('/assets/photos/hero.webp');"></div>
    <div class="content mw-wrap">
      <h1>{homepage?.heroHeading || 'Come as you are.'}</h1>
      <p class="hero-sub">{homepage?.heroSubtitle || 'The recreational heart of Dartington'}</p>
      <div class="actions">
        <a href={homepage?.heroCtaPrimaryUrl || '/facilities'} class="mw-btn mw-btn-sun">{homepage?.heroCtaPrimaryLabel || 'Explore facilities'}</a>
        <a href={homepage?.heroCtaSecondaryUrl || '/about'} class="mw-btn mw-btn-ghost">{homepage?.heroCtaSecondaryLabel || 'About the DRA'}</a>
      </div>
    </div>
  </section>

  <section class="mw-sect tight">
    <div class="mw-wrap mw-intro">
      {introTextNodes
        ? <DocumentRenderer document={introTextNodes} />
        : <p>Meadowbrook is managed by <a href="/about">The Dartington Recreation Association</a>, a charity run by volunteers who manage the Meadowbrook building and surrounding facilities on behalf of the Dartington community.</p>
      }
    </div>
  </section>

  {upcomingEvents.length > 0 && (() => {
    // DRA Socials are never the hero - find the first non-social event for that slot.
    // Socials (and any events before the hero) stay in the compact list.
    const featured = upcomingEvents.find(({ slug }) => !slug.startsWith('dra-social-')) ?? null;
    const rest = upcomingEvents.filter(({ slug }) => slug !== featured?.slug);
    const featuredImage = featured?.entry.image
      ? (featured.entry.image.startsWith('/') ? featured.entry.image : `/images/events/${featured.entry.image}`)
      : null;
    return (
      <section class="mw-sect">
        <div class="mw-wrap">
          <span class="mw-eyebrow">{homepage?.eventsHeading || "What's on"}</span>

          {featured && (
            <div class="mw-event-featured" style="margin-top: var(--space-5);">
              <div class="poster-wrap">
                {featuredImage
                  ? <img src={featuredImage} alt={featured.entry.title} class="poster" />
                  : <div class="poster-placeholder"></div>
                }
              </div>
              <div class="info">
                <p class="event-date">
                  {featured.entry.date ? formatEventDate(featured.entry.date) : ''}
                  {featured.entry.startTime ? ` · ${featured.entry.startTime}${featured.entry.endTime ? `–${featured.entry.endTime}` : ''}` : ''}
                </p>
                <h2><a href={`/calendar/${featured.slug}`} class="event-title-link">{featured.entry.title}</a></h2>
                {featured.entry.summary && <p class="summary">{featured.entry.summary}</p>}
                <div class="actions">
                  {featured.entry.ctaLabel && featured.entry.ctaUrl && (
                    <a href={featured.entry.ctaUrl} class="mw-btn mw-btn-primary">{featured.entry.ctaLabel}</a>
                  )}
                  <a href={`/calendar/${featured.slug}`} class="mw-btn mw-btn-ghost">More details</a>
                </div>
              </div>
            </div>
          )}

          {rest.length > 0 && (
            <div class="mw-event-list">
              {rest.map(({ slug, entry }) => {
                const d = shortDate(entry.date!);
                return (
                  <a href={`/calendar/${slug}`} class="mw-event-list-item">
                    <div class="date-col">
                      <div class="day">{d.day}</div>
                      <div class="mon">{d.mon}</div>
                    </div>
                    <div class="text-col">
                      <h3>{entry.title}</h3>
                      {entry.summary && <p>{entry.summary}</p>}
                    </div>
                    <span class="mw-btn mw-btn-sm mw-btn-secondary">Details</span>
                  </a>
                );
              })}
            </div>
          )}
        </div>
      </section>
    );
  })()}

  <section class="mw-sect">
    <div class="mw-wrap">
      <div class="mw-grid-4">
        {allFacilities.map(({ slug, entry }) => {
          const isBookable = entry.facilityType.discriminant === 'bookable';
          const isLink = entry.facilityType.discriminant === 'link';
          const href = isLink ? (entry.facilityType.value as any).externalUrl : `/facilities/${slug}`;
          const imageSrc = entry.image
            ? (entry.image.startsWith('/') ? entry.image : `/images/facilities/${entry.image}`)
            : null;
          return (
            <a href={href} class={`mw-zone-tile ${zoneFor(slug)} ${slug}${imageSrc ? ' has-photo' : ''}`} {...(isLink ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              {imageSrc && <div class="tile-photo" style={`background-image: url('${imageSrc}')`}></div>}
              {isBookable && <span class="tile-pill">Book now</span>}
              <h3>{entry.name}</h3>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="mw-sect">
    <div class="mw-wrap">
      <div class="mw-banner mw-banner--green">
        <div>
          <span class="mw-eyebrow mw-eyebrow--on-green">{homepage?.energyHubEyebrow || 'Community initiative'}</span>
          <h3>{homepage?.energyHubTitle || 'Meadowbrook Energy Hub'}</h3>
          <p>{homepage?.energyHubBody || "We're working with our neighbours to build shared solar and clean heating infrastructure - cutting costs, cutting carbon, and keeping the benefits in the community."}</p>
          <a href={homepage?.energyHubCtaUrl || '/energy-hub'} class="mw-btn mw-btn-sun">{homepage?.energyHubCtaLabel || 'Find out more'}</a>
        </div>
        <div class="visual" style={`background-image: url('${energyHubImageSrc}');`}></div>
      </div>
    </div>
  </section>

  {aboutPreviewNodes && (
    <section class="mw-sect">
      <div class="mw-wrap">
        <div class="mw-map-block">
          <div class="picture">
            <img src="/assets/illustrations/map.png" alt="Hand-drawn map of Meadowbrook" />
          </div>
          <div class="copy">
            <span class="mw-eyebrow">{homepage?.aboutSectionEyebrow || 'About Meadowbrook'}</span>
            <div class="mw-article" style="padding: 0;">
              <DocumentRenderer document={aboutPreviewNodes} />
            </div>
            <a href="/about" class="mw-btn mw-btn-primary" style="margin-top: 1.5rem;">About the DRA</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {homepage?.banners && homepage.banners.length > 0 && (
    <section class="mw-sect">
      <div class="mw-wrap" style="display: grid; gap: 1.5rem;">
        {homepage.banners.map((banner) => {
          const bannerImg = banner.image
            ? (banner.image.startsWith('/') ? banner.image : `/images/banners/${banner.image}`)
            : '/assets/photos/extravaganza-parachute.webp';
          return (
            <div class="mw-banner">
              <div>
                <h3>{banner.title}</h3>
                <p>{banner.body}</p>
                {banner.link && (
                  <a href={banner.link} class="mw-btn mw-btn-primary">{banner.linkLabel || 'Find out more'}</a>
                )}
              </div>
              <div class="visual" style={`background-image: url('${bannerImg}');`}></div>
            </div>
          );
        })}
      </div>
    </section>
  )}

  <section class="mw-sect tight">
    <div class="mw-wrap">
      <div class="mw-sect-head">
        <div>
          <span class="mw-eyebrow">{homepage?.partnersEyebrow || 'Partners'}</span>
          <h2>{homepage?.partnersHeading || 'In partnership with'}</h2>
        </div>
        {homepage?.partnersIntro && <div class="right">{homepage.partnersIntro}</div>}
      </div>
      {allPartners.length > 0 && (
        <div class="mw-partners">
          {allPartners.map(({ entry }) => {
            const imageSrc = entry.image?.startsWith('/') ? entry.image : entry.image ? `/images/partners/${entry.image}` : null;
            return (
              <a href={entry.url} target="_blank" rel="noopener noreferrer">
                {imageSrc && <img src={imageSrc} alt={entry.name} />}
                <span class="mw-logo-name">{entry.name}</span>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

  {allSupporters.length > 0 && (
    <section class="mw-sect tight">
      <div class="mw-wrap">
        <div class="mw-sect-head">
          <div>
            <span class="mw-eyebrow">{homepage?.supportersEyebrow || 'Supporters'}</span>
            <h2>{homepage?.supportersHeading || 'With thanks to'}</h2>
          </div>
        </div>
        <div class="mw-supporters">
          {allSupporters.map(({ entry }) => {
            const imageSrc = entry.image?.startsWith('/') ? entry.image : entry.image ? `/images/supporters/${entry.image}` : null;
            return (
              <a href={entry.url} target="_blank" rel="noopener noreferrer">
                {imageSrc && <img src={imageSrc} alt={entry.name} />}
                <span class="mw-logo-name">{entry.name}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</Layout>
