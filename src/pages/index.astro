---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { DocumentRenderer } from '@keystatic/core/renderer';
import { zoneFor } from '../lib/zones';

const reader = createReader(process.cwd(), keystaticConfig);

const homepage = await reader.singletons.homepage.read();
const allFacilities = await reader.collections.facilities.all();

const aboutPreviewNodes = homepage?.aboutPreview ? await homepage.aboutPreview() : null;
---

<Layout title="Home" navOnPhoto>
  <section class="mw-hero">
    <div class="photo" style="background-image: url('/assets/photos/hero.webp');"></div>
    <div class="content mw-wrap">
      <h1>{homepage?.heroHeading ?? 'Come as you are.'}</h1>
      <p class="hero-sub">The recreational heart of Dartington</p>
      <div class="actions">
        <a href="/facilities" class="mw-btn mw-btn-sun">Explore facilities</a>
        <a href="/about" class="mw-btn mw-btn-ghost">About the DRA</a>
      </div>
    </div>
  </section>

  <section class="mw-sect tight">
    <div class="mw-wrap mw-intro">
      <p>Meadowbrook is managed by <a href="/about">The Dartington Recreation Association</a>, a charity run by volunteers who manage the Meadowbrook building and surrounding facilities on behalf of the Dartington community.</p>
    </div>
  </section>

  <section class="mw-sect">
    <div class="mw-wrap">
      <div class="mw-grid-4">
        {allFacilities.map(({ slug, entry }) => (
          <a href={`/facilities/${slug}`} class={`mw-zone-tile ${zoneFor(slug)}`}>
            <span class="eyebrow">{entry.facilityType.discriminant === 'bookable' ? 'Bookable' : entry.facilityType.discriminant === 'link' ? 'On site' : 'Explore'}</span>
            <h3>{entry.name}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  {aboutPreviewNodes && (
    <section class="mw-sect">
      <div class="mw-wrap">
        <div class="mw-map-block">
          <div class="picture">
            <img src="/assets/illustrations/map.png" alt="Hand-drawn map of Meadowbrook" />
          </div>
          <div class="copy">
            <span class="mw-eyebrow">About Meadowbrook</span>
            <div class="mw-article" style="padding: 0;">
              <DocumentRenderer document={aboutPreviewNodes} />
            </div>
            <a href="/about" class="mw-btn mw-btn-primary" style="margin-top: 1.5rem;">About the DRA</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {homepage?.banners && homepage.banners.length > 0 && (
    <section class="mw-sect">
      <div class="mw-wrap" style="display: grid; gap: 1.5rem;">
        {homepage.banners.map((banner) => (
          <div class="mw-banner">
            <div>
              <h3>{banner.title}</h3>
              <p>{banner.body}</p>
              {banner.link && (
                <a href={banner.link} class="mw-btn mw-btn-primary">{banner.linkLabel || 'Find out more'}</a>
              )}
            </div>
            <div class="visual" style="background-image: url('/assets/photos/extravaganza-parachute.webp');"></div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="mw-sect tight">
    <div class="mw-wrap">
      <div class="mw-sect-head">
        <div>
          <span class="mw-eyebrow">Partners</span>
          <h2>In partnership with</h2>
        </div>
        {homepage?.partnersIntro && <div class="right">{homepage.partnersIntro}</div>}
      </div>
      <div class="mw-partners">
        <a href="https://www.dartington.org/"><img src="/images/partners/dartington.png" alt="Dartington Hall Trust" /></a>
        <a href="https://bidwellbrook.org/"><img src="/images/partners/bidwell-brook.png" alt="Bidwell Brook School" /></a>
        <a href="https://www.sportengland.org/"><img src="/images/partners/sport-england.png" alt="Sport England" /></a>
        <a href="https://lifeworks-uk.org/"><img src="/images/partners/lifeworks.png" alt="Lifeworks" /></a>
      </div>
    </div>
  </section>
</Layout>
