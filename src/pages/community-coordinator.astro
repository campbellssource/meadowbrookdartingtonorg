---
// The Community Coordinator role closed to expressions of interest on 13 November
// 2026. The page stays up so links already shared on social media and elsewhere
// land somewhere sensible, but it's no longer linked from anywhere on the site.
export const prerender = true;

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Community Coordinator: now closed"
  description="Expressions of interest for the Community Coordinator role at Meadowbrook closed on 13 November 2026. Thank you to everyone who got in touch."
>
  <section class="mw-zone-hero" style="padding-bottom: var(--space-7);">
    <div class="mw-wrap">
      <span class="mw-eyebrow">Paid opportunity</span>
      <h1>Community Coordinator</h1>
    </div>
  </section>

  <section class="mw-sect" style="padding-top: 0;">
    <div class="mw-wrap">
      <article class="mw-article">
        <div class="cc-closed">
          <h2>This role is now closed</h2>
          <p>
            Expressions of interest closed on Friday 13 November 2026, and we're no longer
            taking new ones. Thank you to everyone who got in touch. We'll be in contact with
            each of you about next steps.
          </p>
        </div>

        <p>
          The Dartington Recreation Association (DRA) was looking for a self-employed Community
          Coordinator to help make Meadowbrook Community Centre and Pavilion a vibrant,
          sustainable hub at the heart of the community.
        </p>

        <h2>Still want to get involved?</h2>
        <p>
          There are plenty of other ways to help. Join the
          <a href="/volunteer">volunteer mailing list</a> to hear about events, workdays and odd
          jobs, have a look at our <a href="/projects">projects</a>, or find out about
          <a href="/be-a-trustee">becoming a trustee</a>.
        </p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .cc-closed {
    padding: var(--space-5);
    background: var(--paper-deep);
    border-radius: var(--radius-md, 12px);
  }

  .cc-closed h2 {
    margin-top: 0;
    font-size: 1.3rem;
  }

  .cc-closed p {
    margin-top: var(--space-3);
  }
</style>
