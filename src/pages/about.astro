---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { DocumentRenderer } from '@keystatic/core/renderer';

const reader = createReader(process.cwd(), keystaticConfig);
const entry = await reader.collections.pages.read('about');

const introNodes = entry?.intro ? await entry.intro() : null;
const bodyNodes = entry?.body ? await entry.body() : null;

const documents = {
  key: [
    { title: 'DRA Vision', url: '/documents/DRA-vision.pdf' },
    { title: 'Constitution (2022)', url: '/documents/Dartington-Recreation-Association-Constitution-2022.pdf' },
    { title: 'Handbook and Rules (2023)', url: '/documents/handbook-and-rules-2023.pdf' },
    { title: 'Lease from Dartington Hall Trust', url: '/documents/lease.pdf' },
  ],
  minutes: [
    { title: 'June 2024', url: '/documents/2024-06-11.pdf' },
    { title: 'March 2024', url: '/documents/2024-03-12.pdf' },
    { title: 'January 2024', url: '/documents/2024-01-30.pdf' },
    { title: 'September 2023 - AGM', url: '/documents/2023-09-26-agm.pdf' },
  ],
};
---

<Layout
  title="About"
  description={entry?.seoDescription ?? 'About Meadowbrook and the Dartington Recreation Association'}
  bodyClass="zone-dra"
>
  <section class="mw-zone-hero">
    <div class="mw-wrap">
      <span class="mw-eyebrow">About</span>
      <h1>{entry?.title ?? 'The DRA'}</h1>
      <p>Dartington Recreation Association - the charity that runs Meadowbrook. Volunteers, neighbours, and the people who make it work.</p>
    </div>
  </section>

  <section class="mw-sect" style="background: var(--paper);">
    <div class="mw-wrap">
      <article class="mw-article">
        {introNodes && <div class="lead"><DocumentRenderer document={introNodes} /></div>}
        {bodyNodes && <DocumentRenderer document={bodyNodes} />}
      </article>
    </div>
  </section>

  <section class="mw-sect tight" style="background: var(--paper);">
    <div class="mw-wrap" style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7);">
      <div>
        <span class="mw-eyebrow">Documents</span>
        <h2 style="font-family: var(--font-body); font-weight: 700; font-size: 1.6rem; letter-spacing: -0.02em; margin: var(--space-2) 0 var(--space-5);">Key documents</h2>
        <ul class="mw-doclist">
          {documents.key.map((doc) => (
            <li><a href={doc.url} target="_blank" rel="noopener">{doc.title}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <span class="mw-eyebrow">Trustees</span>
        <h2 style="font-family: var(--font-body); font-weight: 700; font-size: 1.6rem; letter-spacing: -0.02em; margin: var(--space-2) 0 var(--space-5);">Meeting minutes</h2>
        <p>Minutes from trustee meetings are available on Google Drive.</p>
        <p style="margin-top: var(--space-4);"><a href="https://drive.google.com/drive/folders/1chyrWRGYkopiYFYGdZNFxW-RLay6cY_v?usp=share_link" target="_blank" rel="noopener">View meeting minutes on Google Drive →</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 900px) {
    section[class~="mw-sect"][class~="tight"] .mw-wrap {
      grid-template-columns: 1fr !important;
    }
  }
</style>
