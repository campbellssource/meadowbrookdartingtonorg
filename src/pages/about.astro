---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { DocumentRenderer } from '@keystatic/core/renderer';

const reader = createReader(process.cwd(), keystaticConfig);
const entry = await reader.collections.pages.read('about');

const introNodes = entry?.intro ? await entry.intro() : null;
const bodyNodes = entry?.body ? await entry.body() : null;

const documents = {
  key: [
    { title: 'DRA Vision', url: '/documents/DRA-vision.pdf' },
    { title: 'Constitution (2022)', url: '/documents/Dartington-Recreation-Association-Constitution-2022.pdf' },
    { title: 'Handbook and Rules (2023)', url: '/documents/handbook-and-rules-2023.pdf' },
    { title: 'Lease from Dartington Hall Trust', url: '/documents/lease.pdf' },
  ],
  minutes: [
    { title: 'June 2024', url: '/documents/2024-06-11.pdf' },
    { title: 'March 2024', url: '/documents/2024-03-12.pdf' },
    { title: 'January 2024', url: '/documents/2024-01-30.pdf' },
    { title: 'September 2023 - AGM', url: '/documents/2023-09-26-agm.pdf' },
  ]
};
---

<Layout title="About" description={entry?.seoDescription ?? 'About Meadowbrook and the Dartington Recreation Association'}>
  <article class="about-page">
    <h1>{entry?.title ?? 'About Meadowbrook and the Dartington Recreation Association'}</h1>

    {introNodes && (
      <section class="intro">
        <DocumentRenderer document={introNodes} />
      </section>
    )}

    {bodyNodes && (
      <section class="body-content">
        <DocumentRenderer document={bodyNodes} />
      </section>
    )}

    <section class="documents">
      <h2>Key Documents</h2>
      <ul class="document-list">
        {documents.key.map((doc) => (
          <li><a href={doc.url} target="_blank" rel="noopener">{doc.title}</a></li>
        ))}
      </ul>
    </section>

    <section class="minutes">
      <h2>Trustee Meeting Minutes</h2>
      <ul class="document-list">
        {documents.minutes.map((doc) => (
          <li><a href={doc.url} target="_blank" rel="noopener">{doc.title}</a></li>
        ))}
      </ul>
      <p><a href="/documents">View all meeting minutes →</a></p>
    </section>
  </article>
</Layout>

<style>
  .about-page {
    max-width: 800px;
  }

  h1 {
    color: var(--color-primary);
    margin-bottom: 2rem;
  }

  section {
    margin-bottom: 3rem;
  }

  .intro :global(p),
  .body-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .body-content :global(h2) {
    color: var(--color-primary);
    margin-bottom: 1rem;
    border-bottom: 2px solid #eee;
    padding-bottom: 0.5rem;
  }

  .body-content :global(h3) {
    color: var(--color-primary);
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .body-content :global(ul),
  .body-content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .body-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .documents h2,
  .minutes h2 {
    color: var(--color-primary);
    margin-bottom: 1rem;
    border-bottom: 2px solid #eee;
    padding-bottom: 0.5rem;
  }

  .document-list {
    list-style: none;
    margin-left: 0;
    display: grid;
    gap: 0.5rem;
  }

  .document-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    border-radius: 4px;
    background: #f5f5f5;
    transition: background 0.2s;
  }

  .document-list a:hover {
    background: #e8e8e8;
    text-decoration: none;
  }

  .document-list a::before {
    content: '📄';
  }
</style>
