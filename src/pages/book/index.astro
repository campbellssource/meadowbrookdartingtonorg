---
// "Book a room" — the front door to room hire.
//
// Booking used to be reachable only by knowing that a room is a "facility", finding
// it among thirteen tiles, and scrolling to the form. A hirer told us they could not
// find how to book, so the three bookable rooms now have a page of their own that
// the hero, the nav and the footer all point at.
//
// The form itself still lives on each facility page — this page is the chooser, so
// everything here comes from the same Keystatic entries the facility pages use.
import Layout from '../../layouts/Layout.astro';
import { getBookableRooms } from '../../lib/booking/config-reader.ts';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import { zoneFor } from '../../lib/zones';

const reader = createReader(process.cwd(), keystaticConfig);
const rooms = await getBookableRooms();

// Photo, display name and blurb belong to the facility entry, not the booking rules.
const cards = await Promise.all(rooms.map(async (room) => {
  const facility = await reader.collections.facilities.read(room.slug);
  const value = facility?.facilityType.value as { amenities?: string[] } | undefined;
  return {
    room,
    name: facility?.name ?? room.shortName,
    description: facility?.shortDescription ?? '',
    image: facility?.image ?? null,
    // The amenity list doubles as prose on the facility page, so some entries are
    // whole sentences. Only the ones that read as chips are pulled through here.
    amenities: (value?.amenities ?? []).filter((a) => a.length <= 34).slice(0, 4),
    zone: zoneFor(room.slug),
    order: facility?.order ?? 99,
  };
}));
// getBookableRooms() comes back in slug order; the rest of the site orders
// facilities by the `order` field, and the nav's room list does too.
cards.sort((a, b) => a.order - b.order);

const rate = (pence: number) => `£${(pence / 100).toFixed(2)}`;
// Identical across all three rooms today, but read rather than hardcoded.
const openingFrom = cards[0]?.room.openingHours[0]?.from ?? '08:00';
const openingTo = cards[0]?.room.openingHours[0]?.to ?? '23:00';
// "08:00" -> "8am", "23:00" -> "11pm", "17:30" -> "5.30pm".
function clock(t: string): string {
  const [h, m] = t.split(':').map(Number);
  const suffix = h < 12 ? 'am' : 'pm';
  const hour = h % 12 === 0 ? 12 : h % 12;
  return m ? `${hour}.${String(m).padStart(2, '0')}${suffix}` : `${hour}${suffix}`;
}

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Rooms to hire at Meadowbrook Dartington",
  itemListElement: cards.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    url: `https://meadowbrookdartington.org/facilities/${c.room.slug}`,
  })),
};
---

<Layout
  title="Book a room"
  description="Hire a room at Meadowbrook in Dartington, near Totnes. Three rooms — the Studio, the Lounge and the Snooker Room — bookable online by the hour."
  structuredData={structuredData}
>
  <section class="mw-zone-hero bk-hero">
    <div class="mw-wrap">
      <span class="mw-eyebrow">Room hire</span>
      <h1>Book a room.</h1>
      <p>
        Three rooms at Meadowbrook, bookable online by the hour. Pick a room, choose your
        time, pay, and your confirmation and door code arrive by email.
      </p>
    </div>
  </section>

  <section class="mw-sect" style="padding-top: var(--space-6);">
    <div class="mw-wrap">
      <div class="bk-rooms">
        {cards.map(({ room, name, description, image, amenities, zone }) => (
          <article class={`bk-room zone-tint-${zone}`}>
            <a href={`/facilities/${room.slug}#book`} class="bk-room-photo" aria-hidden="true" tabindex="-1">
              {image
                ? <img src={image} alt="" loading="lazy" />
                : <span class="bk-room-photo-blank"></span>
              }
            </a>
            <div class="bk-room-body">
              <div class="bk-room-head">
                <h2><a href={`/facilities/${room.slug}#book`}>{name}</a></h2>
                <p class="bk-room-rate"><strong>{rate(room.hourlyRatePence)}</strong> <span>per hour</span></p>
              </div>
              {description && <p class="bk-room-desc">{description}</p>}
              {amenities.length > 0 && (
                <ul class="bk-room-facts">
                  {amenities.map((a) => <li>{a}</li>)}
                </ul>
              )}
              <div class="bk-room-actions">
                <a href={`/facilities/${room.slug}#book`} class="mw-btn mw-btn-primary">Check availability</a>
                <a href={`/facilities/${room.slug}`} class="bk-room-more">About the {room.shortName}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mw-sect tight">
    <div class="mw-wrap">
      <div class="bk-how">
        <div>
          <span class="mw-eyebrow">How it works</span>
          <h2>Booked in a couple of minutes.</h2>
        </div>
        <ul class="bk-how-list">
          <li>
            <strong>Open {clock(openingFrom)} to {clock(openingTo)}, every day.</strong>
            Minimum one hour, then in half-hour steps.
          </li>
          <li>
            <strong>Pay online to confirm.</strong>
            A slot stays available to others until payment goes through.
          </li>
          <li>
            <strong>Your door code comes with the confirmation.</strong>
            It works for your booking only, and stops working afterwards.
          </li>
          <li>
            <strong>Change or cancel free up to an hour before.</strong>
            Cancel and you are refunded automatically. See the <a href="/room-hire-terms">room hire terms</a>.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mw-sect tight">
    <div class="mw-wrap">
      <div class="bk-footer-links">
        <a href="/bookings/find" class="mw-btn mw-btn-secondary">Find an existing booking</a>
        <a href="mailto:bookings@meadowbrookdartington.org" class="bk-room-more">Questions? bookings@meadowbrookdartington.org</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bk-hero { padding-bottom: var(--space-6); }
  .bk-hero h1 { max-width: 12ch; }

  .bk-rooms { display: grid; gap: var(--space-5); }

  .bk-room {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--space-6);
    align-items: stretch;
    background: var(--bg-elevated);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .bk-room-photo { display: block; background: var(--paper-deep); }
  .bk-room-photo img { width: 100%; height: 100%; min-height: 220px; object-fit: cover; display: block; }
  .bk-room-photo-blank { display: block; width: 100%; height: 100%; min-height: 220px; }

  .bk-room-body { padding: var(--space-6) var(--space-6) var(--space-6) 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .bk-room-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); flex-wrap: wrap; }
  .bk-room-head h2 { font-family: var(--font-body); font-size: clamp(1.5rem, 2.6vw, 2rem); font-weight: 700; letter-spacing: -0.02em; margin: 0; line-height: 1.05; }
  .bk-room-head h2 a { color: var(--fg); text-decoration: none; }
  .bk-room-head h2 a:hover { text-decoration: underline; }
  .bk-room-rate { margin: 0; font-size: 15px; color: var(--fg-soft); white-space: nowrap; }
  .bk-room-rate strong { font-size: 20px; font-weight: 700; color: var(--fg); }

  .bk-room-desc { margin: 0; font-size: 15px; line-height: 1.6; color: var(--fg-soft); max-width: 62ch; }

  .bk-room-facts { list-style: none; margin: var(--space-1) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .bk-room-facts li {
    font-size: 13px; line-height: 1.3; color: var(--fg-soft);
    background: var(--paper-deep); border-radius: var(--r-pill); padding: 6px 12px;
  }

  .bk-room-actions { margin-top: auto; padding-top: var(--space-4); display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; }
  .bk-room-more { font-size: 14px; font-weight: 600; color: var(--fg-soft); text-decoration: none; }
  .bk-room-more:hover { color: var(--fg); }

  /* A thread of each room's own colour, so the three read as distinct spaces. */
  .bk-room { border-left: 6px solid var(--tint, transparent); }
  .zone-tint-studio  { --tint: #C79A4A; }
  .zone-tint-lounge  { --tint: #401D00; }
  .zone-tint-snooker { --tint: #004D26; }

  .bk-how { display: grid; grid-template-columns: 1fr 1.6fr; gap: var(--space-6); align-items: start; }
  .bk-how h2 { font-family: var(--font-body); font-size: clamp(1.6rem, 2.6vw, 2.1rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin: 10px 0 0; max-width: 14ch; }
  .bk-how-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .bk-how-list li { font-size: 15px; line-height: 1.6; color: var(--fg-soft); }
  .bk-how-list strong { display: block; color: var(--fg); font-weight: 600; }

  .bk-footer-links { display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; }

  @media (max-width: 900px) {
    .bk-room { grid-template-columns: 1fr; gap: 0; }
    .bk-room-photo img, .bk-room-photo-blank { min-height: 200px; max-height: 260px; }
    .bk-room-body { padding: var(--space-5); }
    .bk-how { grid-template-columns: 1fr; gap: var(--space-5); }
  }
</style>
